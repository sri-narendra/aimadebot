# LLM Provider API Keys
# Get these from their respective dashboards
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Primary LLM Provider: groq, gemini, mistral, openrouter, nvidia, ollama, fallback
LLM_PROVIDER=groq

# Ollama local setup (only needed if using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434

# Vector Database: chroma or faiss
VECTOR_DB=chroma
CHROMA_DB_DIR=./vectordb

# CORS - set to your frontend domain
ALLOWED_ORIGIN=*

# RAG Settings
TOP_K_RESULTS=4
MAX_CONTEXT_CHARS=4000
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Provider Fallback
ENABLE_PROVIDER_FALLBACK=true
